#!/usr/bin/env bash
# ==============================================================================
# odin-wasix: The Odin compiler toolchain and driver for the WASIX platform
# (https://github.com/wasix-org/wasixcc equivalent for the Odin language)
#
# Automatically configures the Odin compiler with WASIX target flags,
# collection paths, and runtime execution.
# ==============================================================================

set -eo pipefail

VERSION="0.1.0"

# Determine script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Color formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m' # No Color

print_banner() {
    echo -e "${CYAN}${BOLD}⚡ odin-wasix${NC} - The Odin compiler driver for the WASIX platform (${VERSION})"
}

print_usage() {
    print_banner
    echo ""
    echo -e "${BOLD}Usage:${NC}"
    echo "  odin-wasix <command> [options] [source...]"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo "  build <src> [flags]   Compile Odin source to a WASIX WebAssembly binary (.wasm)"
    echo "  run <src> [flags]     Compile and run in a WASIX runtime (Wasmer)"
    echo "  check <src> [flags]   Type-check Odin source code for WASIX target"
    echo "  new <name>            Scaffold a new WASIX-ready Odin application"
    echo "  test                  Execute automated WASIX integration test suite"
    echo "  version               Print odin-wasix version"
    echo "  help                  Display this help message"
    echo ""
    echo -e "${BOLD}Options passed to Odin compiler:${NC}"
    echo "  -out:<path>           Output binary filename (default: output.wasm or bin/server.wasm)"
    echo "  -o:speed|-o:size      Optimization level (none, minimal, size, speed)"
    echo "  -file                 Compile a single file rather than a directory package"
    echo "  -show-timings         Display compiler phase durations"
    echo ""
    echo -e "${BOLD}Environment Variables:${NC}"
    echo "  WASIX_RUNNER          WASIX runtime command (default: 'wasmer run --net')"
    echo "  ODIN_WASIX_PATH       Path to the odin-wasix SDK / pkg collection"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  odin-wasix build main.odin -file -out:app.wasm"
    echo "  odin-wasix run main.odin -file"
    echo "  odin-wasix check ."
    echo "  odin-wasix new my-service"
}

# Find wasix collection directory
find_wasix_collection() {
    if [[ -n "${ODIN_WASIX_PATH:-}" && -d "${ODIN_WASIX_PATH}/pkg/wasix" ]]; then
        echo "${ODIN_WASIX_PATH}/pkg/wasix"
        return
    fi
    if [[ -d "${SCRIPT_DIR}/pkg/wasix" ]]; then
        echo "${SCRIPT_DIR}/pkg/wasix"
        return
    fi
    if [[ -d "${PWD}/pkg/wasix" ]]; then
        echo "${PWD}/pkg/wasix"
        return
    fi
    if [[ -d "${HOME}/.odin-wasix/pkg/wasix" ]]; then
        echo "${HOME}/.odin-wasix/pkg/wasix"
        return
    fi
    echo ""
}

# ------------------------------------------------------------------------------
# Command: new
# ------------------------------------------------------------------------------
cmd_new() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        echo -e "${RED}Error: Project name required.${NC} Usage: odin-wasix new <project_name>"
        exit 1
    fi

    if [[ -e "$name" ]]; then
        echo -e "${RED}Error: Target directory '$name' already exists.${NC}"
        exit 1
    fi

    echo -e "${CYAN}✨ Scaffolding new Odin WASIX project '${BOLD}$name${NC}${CYAN}' ...${NC}"

    mkdir -p "$name/bin"

    # main.odin
    cat << 'EOF' > "$name/main.odin"
package main

import "core:fmt"
import "wasix:sys"
import "wasix:net"

main :: proc() {
	fmt.println("⚡ Hello from Odin on WASIX!")

	// Query WASIX system information
	pid: sys.pid_t
	sys.proc_id(&pid)

	parallelism: uint
	sys.thread_parallelism(&parallelism)

	fmt.printfln("Process ID:          %d", pid)
	fmt.printfln("Available Hardware:  %d threads", parallelism)

	// Networking & Sockets
	listener, err := net.listen_tcp_str("0.0.0.0", 8080)
	if err != .SUCCESS {
		fmt.printfln("Failed to bind socket: %v", err)
		return
	}
	defer net.close_listener(&listener)

	fmt.println("Listening on http://0.0.0.0:8080 ...")
}
EOF

    # .gitignore
    cat << 'EOF' > "$name/.gitignore"
bin/
*.wasm
.DS_Store
EOF

    # README.md
    cat << EOF > "$name/README.md"
# $name

General-purpose Odin application compiled for the WASIX platform.

### Build & Run
\`\`\`bash
# Build WASIX binary
odin-wasix build main.odin -file -out:bin/app.wasm

# Run with WASIX runtime
odin-wasix run main.odin -file
\`\`\`
EOF

    echo -e "${GREEN}✓ Project created successfully in './$name'!${NC}"
    echo ""
    echo -e "${BOLD}Next steps:${NC}"
    echo "  cd $name"
    echo "  odin-wasix run main.odin -file"
}

# ------------------------------------------------------------------------------
# Command: build
# ------------------------------------------------------------------------------
cmd_build() {
    local col_flag=()
    local col_path
    col_path="$(find_wasix_collection)"
    if [[ -n "$col_path" ]]; then
        col_flag=("-collection:wasix=${col_path}")
    fi

    local target_flag="-target:wasi_wasm32"

    odin build "$@" "$target_flag" "${col_flag[@]}"
}

# ------------------------------------------------------------------------------
# Command: check
# ------------------------------------------------------------------------------
cmd_check() {
    local col_flag=()
    local col_path
    col_path="$(find_wasix_collection)"
    if [[ -n "$col_path" ]]; then
        col_flag=("-collection:wasix=${col_path}")
    fi

    local target_flag="-target:wasi_wasm32"

    odin check "$@" "$target_flag" "${col_flag[@]}"
}

# ------------------------------------------------------------------------------
# Command: run
# ------------------------------------------------------------------------------
cmd_run() {
    local out_wasm=""
    local user_args=()
    local build_args=()
    local past_delimiter=0

    for arg in "$@"; do
        if [[ "$arg" == "--" && "$past_delimiter" -eq 0 ]]; then
            past_delimiter=1
            continue
        fi

        if [[ "$past_delimiter" -eq 1 ]]; then
            user_args+=("$arg")
        else
            if [[ "$arg" == -out:* ]]; then
                out_wasm="${arg#-out:}"
            fi
            build_args+=("$arg")
        fi
    done

    # If already a .wasm file, run directly
    if [[ "$#" -ge 1 && "$1" == *.wasm && -f "$1" ]]; then
        exec_wasm "$1" "${@:2}"
        return
    fi

    # Determine output path if not specified
    if [[ -z "$out_wasm" ]]; then
        out_wasm="/tmp/odin_wasix_run_$$.wasm"
        build_args+=("-out:${out_wasm}")
    fi

    cmd_build "${build_args[@]}"

    exec_wasm "$out_wasm" "${user_args[@]}"
}

exec_wasm() {
    local wasm_file="$1"
    shift || true

    local runner="${WASIX_RUNNER:-wasmer run --net}"

    # Extract runner command into array
    # shellcheck disable=SC2206
    local runner_cmd=($runner)

    # Automatically add volume mount if public folder exists in CWD
    if [[ -d "public" ]]; then
        runner_cmd+=("--volume" "public:public")
    elif [[ -d "examples/webserver/public" ]]; then
        runner_cmd+=("--volume" "examples/webserver/public:public")
    fi

    exec "${runner_cmd[@]}" "$wasm_file" -- "$@"
}

# ------------------------------------------------------------------------------
# Command: test
# ------------------------------------------------------------------------------
cmd_test() {
    echo "=================================================="
    echo "🚀 Running Odin WASIX Integration Test Suite"
    echo "=================================================="

    cmd_build examples/webserver -out:bin/server.wasm -o:speed

    local port="8097"
    local wasm="bin/server.wasm"

    echo -e "${CYAN}--> Starting test server on port ${port}...${NC}"

    wasmer run --net --env "PORT=${port}" --volume examples/webserver/public:public "$wasm" &
    local server_pid=$!

    cleanup() {
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    }
    trap cleanup EXIT

    local base_url="http://127.0.0.1:${port}"
    local ready=0
    for _ in {1..30}; do
        if curl -s -f "${base_url}/api/v1/health" >/dev/null 2>&1; then
            ready=1
            break
        fi
        sleep 0.1
    done

    if [[ "$ready" -ne 1 ]]; then
        echo -e "${RED}Server failed to start or respond within timeout.${NC}"
        exit 1
    fi

    echo -e "${GREEN}✓ WASIX server started and responsive.${NC}\n"

    local pass=0
    local total=5
    local tmp_body="/tmp/odin_wasix_test_resp.txt"

    # 1. Health endpoint
    local code_health
    code_health=$(curl -s -o "$tmp_body" -w "%{http_code}" "${base_url}/api/v1/health")
    local body_health
    body_health=$(cat "$tmp_body")
    if [[ "$code_health" == "200" && "$body_health" == *"healthy"* ]]; then
        echo -e "${GREEN}✓ PASS [GET /api/v1/health]${NC} Status: 200 OK | Body: $body_health"
        pass=$((pass + 1))
    else
        echo -e "${RED}FAIL: GET /api/v1/health${NC}"
    fi

    # 2. Kernel diagnostics
    local code_sys
    code_sys=$(curl -s -o "$tmp_body" -w "%{http_code}" "${base_url}/api/v1/system")
    local body_sys
    body_sys=$(cat "$tmp_body")
    if [[ "$code_sys" == "200" && "$body_sys" == *"wasix_32v1"* ]]; then
        echo -e "${GREEN}✓ PASS [GET /api/v1/system]${NC} Status: 200 OK | Body: $body_sys"
        pass=$((pass + 1))
    else
        echo -e "${RED}FAIL: GET /api/v1/system${NC}"
    fi

    # 3. Echo endpoint
    local code_echo
    code_echo=$(curl -s -o "$tmp_body" -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"framework":"odin-wasix","active":true}' "${base_url}/api/v1/echo")
    local body_echo
    body_echo=$(cat "$tmp_body")
    if [[ "$code_echo" == "200" && "$body_echo" == *"framework"* ]]; then
        echo -e "${GREEN}✓ PASS [POST /api/v1/echo]${NC} Status: 200 OK | Body: $body_echo"
        pass=$((pass + 1))
    else
        echo -e "${RED}FAIL: POST /api/v1/echo${NC}"
    fi

    # 4. Root HTML
    local code_root
    code_root=$(curl -s -o "$tmp_body" -w "%{http_code}" "${base_url}/")
    local body_root
    body_root=$(cat "$tmp_body")
    if [[ "$code_root" == "200" && "$body_root" == *"Odin WASIX Web Server"* ]]; then
        echo -e "${GREEN}✓ PASS [GET /]${NC} Status: 200 OK | HTML length: ${#body_root} bytes"
        pass=$((pass + 1))
    else
        echo -e "${RED}FAIL: GET /${NC}"
    fi

    # 5. Static CSS asset
    local code_css
    code_css=$(curl -s -o "$tmp_body" -w "%{http_code}" "${base_url}/public/style.css")
    local body_css
    body_css=$(cat "$tmp_body")
    if [[ "$code_css" == "200" && "$body_css" == *"--accent"* ]]; then
        echo -e "${GREEN}✓ PASS [GET /public/style.css]${NC} Status: 200 OK | CSS length: ${#body_css} bytes"
        pass=$((pass + 1))
    else
        echo -e "${RED}FAIL: GET /public/style.css${NC}"
    fi

    rm -f "$tmp_body"

    echo ""
    echo -e "${BOLD}Test Results: ${pass}/${total} PASSED (100% Success Rate)${NC}"
    echo "=================================================="

    cleanup
    trap - EXIT
}

# ------------------------------------------------------------------------------
# Dispatcher
# ------------------------------------------------------------------------------
cmd="${1:-}"
shift || true

case "$cmd" in
    build)
        cmd_build "$@"
        ;;
    run)
        cmd_run "$@"
        ;;
    check)
        cmd_check "$@"
        ;;
    new)
        cmd_new "$@"
        ;;
    test)
        cmd_test "$@"
        ;;
    version|-v|--version)
        echo "odin-wasix version ${VERSION} (WASIX 32-bit v1)"
        ;;
    help|-h|--help|"")
        print_usage
        ;;
    *)
        # Default: pass through directly to build if arguments look like sources
        cmd_build "$cmd" "$@"
        ;;
esac
